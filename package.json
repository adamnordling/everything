{
  "name": "everything",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --check \"*.html\" \"src/**/*.{ts,css,html}\"",
    "format:fix": "prettier --write \"*.html\" \"src/**/*.{ts,css,html}\"",
    "fix": "npm run lint:fix && npm run format:fix",
    "validate": "npm run typecheck && npm run lint && npm run format"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "none",
    "printWidth": 120,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.9.8",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}